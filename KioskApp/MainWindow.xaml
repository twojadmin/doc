<Window x:Class="KioskApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Kiosk"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#1E1E1E">
    <Grid>
        <!-- Tryb kiosk: strona logowania na pełnym ekranie -->
        <wv2:WebView2 x:Name="Web" />

        <!-- Tryb mini: małe okno z nazwą użytkownika -->
        <Border x:Name="MiniPanel"
                Visibility="Collapsed"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                Padding="12,0"
                MouseLeftButtonDown="MiniPanel_MouseLeftButtonDown">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Zalogowano jako" Foreground="#A0A0A0" FontSize="11" />
                    <TextBlock x:Name="UserNameText"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Wyloguj"
                        Padding="12,4"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Click="Logout_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
